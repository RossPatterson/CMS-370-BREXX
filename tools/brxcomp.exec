&CONTROL OFF
* USE KEEP PARM TO GENERATE ASSEMBLER
&IF &INDEX GE 1 &SKIP 2
   &TYPE Syntax: &0 c_fn [parm_fn|STDBRX [GCC options]]
   &EXIT 1
STATE &1 C *
&IF &RETCODE NE 0 &EXIT &RETCODE
&IF .&2 EQ . &2 = STDBRX
STATE &2 PARM *
&IF &RETCODE NE 0 &EXIT &RETCODE
GLOBAL MACLIB GCCLIB CMSHRC CMSLIB OSMACRO TSOMAC
EXEC GCC &1 ( CSECT LIB GCCLIB PARM &2 &3 &4 &5 &6 &7 &8 &9 &10
&GCCRC = &RETCODE
EXEC TXTDATE &1 TEXT A &1 C * &2 PARM * ( MACLIB
&EXIT &GCCRC
