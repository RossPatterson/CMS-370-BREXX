COPYFILE CHANGEST TEXT A &FN TEXT A (APPEND
COPYFILE CHARIN   TEXT A &FN TEXT A (APPEND
COPYFILE CHAROUT  TEXT A &FN TEXT A (APPEND
COPYFILE CHARS    TEXT A &FN TEXT A (APPEND
COPYFILE CMSFUNC  TEXT A &FN TEXT A (APPEND
COPYFILE COMPARE  TEXT A &FN TEXT A (APPEND
COPYFILE COMPILE  TEXT A &FN TEXT A (APPEND
COPYFILE CONTEXT  TEXT A &FN TEXT A (APPEND
COPYFILE COPIES   TEXT A &FN TEXT A (APPEND
COPYFILE COUNTSTR TEXT A &FN TEXT A (APPEND
COPYFILE C2D      TEXT A &FN TEXT A (APPEND
COPYFILE C2X      TEXT A &FN TEXT A (APPEND
COPYFILE DATATYPE TEXT A &FN TEXT A (APPEND
COPYFILE DATE     TEXT A &FN TEXT A (APPEND
COPYFILE DEC      TEXT A &FN TEXT A (APPEND
COPYFILE DELSTR   TEXT A &FN TEXT A (APPEND
COPYFILE DELWORD  TEXT A &FN TEXT A (APPEND
COPYFILE DIV      TEXT A &FN TEXT A (APPEND
COPYFILE DQUEUE   TEXT A &FN TEXT A (APPEND
COPYFILE D2C      TEXT A &FN TEXT A (APPEND
COPYFILE D2X      TEXT A &FN TEXT A (APPEND
COPYFILE EQUAL    TEXT A &FN TEXT A (APPEND
COPYFILE ERROR    TEXT A &FN TEXT A (APPEND
COPYFILE ERRORTXT TEXT A &FN TEXT A (APPEND
COPYFILE EXPOSE   TEXT A &FN TEXT A (APPEND
COPYFILE EXPR     TEXT A &FN TEXT A (APPEND
COPYFILE FORMAT   TEXT A &FN TEXT A (APPEND
COPYFILE HASHVALU TEXT A &FN TEXT A (APPEND
COPYFILE INC      TEXT A &FN TEXT A (APPEND
COPYFILE INDEX    TEXT A &FN TEXT A (APPEND
COPYFILE INSERT   TEXT A &FN TEXT A (APPEND
COPYFILE INTDIV   TEXT A &FN TEXT A (APPEND
COPYFILE INTERPRE TEXT A &FN TEXT A (APPEND
COPYFILE JUSTIFY  TEXT A &FN TEXT A (APPEND
COPYFILE LASTPOS  TEXT A &FN TEXT A (APPEND
COPYFILE LINEIN   TEXT A &FN TEXT A (APPEND
COPYFILE LINEOUT  TEXT A &FN TEXT A (APPEND
COPYFILE LINES    TEXT A &FN TEXT A (APPEND
COPYFILE LOWER    TEXT A &FN TEXT A (APPEND
COPYFILE LSTRING  TEXT A &FN TEXT A (APPEND
COPYFILE LTIME    TEXT A &FN TEXT A (APPEND
COPYFILE MOD      TEXT A &FN TEXT A (APPEND
COPYFILE MULT     TEXT A &FN TEXT A (APPEND
COPYFILE NEG      TEXT A &FN TEXT A (APPEND
COPYFILE NEXTSYMB TEXT A &FN TEXT A (APPEND
COPYFILE OPTIONS  TEXT A &FN TEXT A (APPEND
COPYFILE OVERLAY  TEXT A &FN TEXT A (APPEND
COPYFILE PRINT    TEXT A &FN TEXT A (APPEND
COPYFILE READ     TEXT A &FN TEXT A (APPEND
COPYFILE REVERSE  TEXT A &FN TEXT A (APPEND
COPYFILE REXX     TEXT A &FN TEXT A (APPEND
COPYFILE REXXFUNC TEXT A &FN TEXT A (APPEND
COPYFILE RIGHT    TEXT A &FN TEXT A (APPEND
COPYFILE RXCONV   TEXT A &FN TEXT A (APPEND
COPYFILE RXFILES  TEXT A &FN TEXT A (APPEND
COPYFILE RXMATH   TEXT A &FN TEXT A (APPEND
COPYFILE RXSTR    TEXT A &FN TEXT A (APPEND
COPYFILE RXWORD   TEXT A &FN TEXT A (APPEND
COPYFILE SIGN     TEXT A &FN TEXT A (APPEND
COPYFILE SOUNDEX  TEXT A &FN TEXT A (APPEND
COPYFILE SPACE    TEXT A &FN TEXT A (APPEND
COPYFILE STACK    TEXT A &FN TEXT A (APPEND
COPYFILE STRIP    TEXT A &FN TEXT A (APPEND
COPYFILE SUB      TEXT A &FN TEXT A (APPEND
COPYFILE SUBSTR   TEXT A &FN TEXT A (APPEND
COPYFILE SUBWORD  TEXT A &FN TEXT A (APPEND
COPYFILE TEMPLATE TEXT A &FN TEXT A (APPEND
COPYFILE TRACE    TEXT A &FN TEXT A (APPEND
COPYFILE TRANSLAT TEXT A &FN TEXT A (APPEND
COPYFILE TRUNC    TEXT A &FN TEXT A (APPEND
COPYFILE UPPER    TEXT A &FN TEXT A (APPEND
COPYFILE VARIABLE TEXT A &FN TEXT A (APPEND
COPYFILE VERIFY   TEXT A &FN TEXT A (APPEND
COPYFILE WORD     TEXT A &FN TEXT A (APPEND
COPYFILE WORDIDX  TEXT A &FN TEXT A (APPEND
COPYFILE WORDLEN  TEXT A &FN TEXT A (APPEND
COPYFILE WORDPOS  TEXT A &FN TEXT A (APPEND
