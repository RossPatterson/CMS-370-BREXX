COPYFILE RXEXCOMM TEXT A &FN TEXT A (APPEND
COPYFILE HOSTFNC  TEXT A &FN TEXT A (APPEND
COPYFILE DISASM   TEXT A &FN TEXT A (APPEND

*************************************************
* Append GCCRES TXTLIB files meeded by resident bREXX.
*************************************************
VMFDATE GCCRES TXTLIB * &FN TEXT A
FILEDEF INMOVE DISK GCCRES TXTLIB * ( MEMBER CMSCRT0
FILEDEF OUTMOVE DISK &FN TEXT A ( DISP MOD
MOVEFILE
FILEDEF INMOVE DISK GCCRES TXTLIB * ( MEMBER CMSENTRY
MOVEFILE
FILEDEF INMOVE DISK GCCRES TXTLIB * ( MEMBER CMSRTST@
MOVEFILE
FILEDEF INMOVE DISK GCCRES TXTLIB * ( MEMBER DYNSTK
MOVEFILE
FILEDEF INMOVE DISK GCCRES TXTLIB * ( MEMBER CMSSTUBS
MOVEFILE
*
* Create a load map for debugging.
LOAD &FN ( NOAUTO NOLIBE
COPY LOAD MAP A &FN MAP A ( OLDDATE REPLACE
ERASE LOAD MAP A
&EXIT 0
