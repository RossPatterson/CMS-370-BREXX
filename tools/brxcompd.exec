&CONTROL OFF
* USE KEEP PARM TO GENERATE ASSEMBLER
GLOBAL MACLIB GCCLIB CMSHRC CMSLIB OSMACRO TSOMAC
EXEC GCC &1 ( CSECT LIB GCCLIB PARM DBGBRX &2 &3
&GCCRC = &RETCODE
&IF &GCCRC EQ 0 &GOTO -DONE
&TYPE &1 WORK1 A
TYPE &1 WORK1 A
TYPE &1 WORK1 A ( HEX
&TYPE &1 WORK2 A
TYPE &1 WORK2 A
TYPE &1 WORK2 A (HEX
-DONE
ERASE &1 WORK1 A
ERASE &1 WORK2 A
EXEC TXTDATE &1 C TEXT DBGBRX
&EXIT &GCCRC
