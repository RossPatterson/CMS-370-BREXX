&CONTROL OFF NOMSG
* TXTDATE source_fn source_ft text_ft [parm_fn]
&FN = &1
&SRCFT = &2
&TEXTFT = &3
&PARMFN = &4
ERASE &0 CMSUT1 A
MAKEBUF
&BUFFER = &RETCODE
SENTRIES
&BEFORE = &RETCODE
QUERY MACLIB ( FIFO
SENTRIES
&AFTER = &RETCODE - &BEFORE
&L = 1
&LOOP 7 &L GT &AFTER
    &READ ARGS
    &ARGS &3 &4 &5 &6 &7 &8 &9 &10
    &I = 1
    &LOOP 2 &I GT &INDEX
         VMFDATE &&I MACLIB * &0 CMSUT1 A1
         &I = &I + 1
    &L = &L + 1
DROPBUF &BUFFER
&CONTROL ERROR
VMFDATE &FN &SRCFT * &0 CMSUT1 A1
&IF .&PARMFM EQ . &SKIP 1
    VMFDATE &PARMFN PARM * &0 CMSUT1 A1
COPY &FN &TEXTFT A &0 CMSUT1 A1 (APPEND
&IF &RETCODE EQ 0 ERASE &FN &TEXTFT A
&IF &RETCODE EQ 0 RENAME &0 CMSUT1 A &FN &TEXTFT =
&EXIT &RETCODE