/* CHANGESTR */
say 'Testing CHANGESTR ...'
fail_count=0
if changestr('bc','abcabcabc','xy') \== 'axyaxyaxy' then call test_failed '1'
if changestr('bc','abcabcabc','') \== 'aaa' then call test_failed '2'
if changestr('','abcabcabc','xy') \== 'abcabcabc' then call test_failed '3'
/* These from Mark Hessling. */
if changestr('a','fred','c') \== 'fred' then call test_failed '4'
if changestr('','','x') \== '' then call test_failed '5'
if changestr('a','abcdef','x') \== 'xbcdef' then call test_failed '6'
if changestr('0','0','1') \== '1' then call test_failed '7'
if changestr('a','def','xyz') \== 'def' then call test_failed '8'
if changestr('a','','x') \== '' then call test_failed '9'
if changestr('','def','xyz') \== 'def' then call test_failed '10'
if changestr('abc','abcdef','xyz') \== 'xyzdef' then call test_failed '11'
if changestr('abcdefg','abcdef','xyz') \== 'abcdef' then call test_failed '12'
if changestr('abc','abcdefabccdabcd','z') \== 'zdefzcdzd' then call test_failed '13'
say '... CHANGESTR done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
