/* COUNTSTR */
say 'Testing COUNTSTR ...'
fail_count=0
/* These from TRL2. */
if countstr('y','xyzzy') \= 2 then call test_failed '1'
/* These from ??? */
if countstr('bc','abcabcabc') \= 3 then call test_failed '2'
if countstr('aa','aaaa') \= 2 then call test_failed '3'
/* Loops forever - figure it out later
if countstr('','a a') \= 0 then call test_failed '4'
*/
/* These from Mark Hessling. */
if countstr('','') \== 0 then call test_failed '4'
if countstr('a','abcdef') \== 1 then call test_failed '5'
if countstr(0,0) \== 1 then call test_failed '6'
if countstr('a','def') \== 0 then call test_failed '7'
if countstr('a','') \== 0 then call test_failed '8'
/* Loops forever - figure it out later
if countstr('','def') \== 0 then call test_failed '9'
*/
if countstr('abc','abcdef') \== 1 then call test_failed '10'
if countstr('abcdefg','abcdef') \== 0 then call test_failed '11'
if countstr('abc','abcdefabccdabcd') \== 3 then call test_failed '12'
say '... COUNTSTR done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
