/* DELWORD */
say 'Testing DELWORD ...'
fail_count=0
/* These from TRL2. */
if delword('Now is the time',2,2) \== 'Now time' then call test_failed '1'
if delword('Now is the time ',3) \== 'Now is ' then call test_failed '2'
if delword('Now time',5) \== 'Now time' then call test_failed '3'
/* These from Mark Hessling. */
if delword('Med lov skal land bygges', 3) \== 'Med lov ' then call test_failed '4'
if delword('Med lov skal land bygges', 1) \== '' then call test_failed '5'
if delword('Med lov skal land bygges', 1,1) \== 'lov skal land bygges' then call test_failed '6'
if delword('Med lov skal land bygges', 2,3) \== 'Med bygges' then call test_failed '7'
if delword('Med lov skal land bygges', 2,10) \== 'Med ' then call test_failed '8'
if delword('Med lov skal land bygges', 3,2) \== 'Med lov bygges' then call test_failed '9'
if delword('Med lov skal land bygges', 3,2) \== 'Med lov bygges' then call test_failed '10'
if delword('Med lov skal land bygges', 3,2) \== 'Med lov bygges' then call test_failed '11'
if delword('Med lov skal land bygges', 3,0) \== 'Med lov skal land bygges' then call test_failed '12'
if delword('Med lov skal land bygges', 10) \== 'Med lov skal land bygges' then call test_failed '13'
if delword('Med lov skal land bygges', 9,9) \== 'Med lov skal land bygges' then call test_failed '14'
if delword('Med lov skal land bygges', 1,0) \== 'Med lov skal land bygges' then call test_failed '15'
if delword(' Med lov skal', 1,0) \== ' Med lov skal' then call test_failed '16'
if delword(' Med lov skal ', 4) \== ' Med lov skal ' then call test_failed '17'
if delword('', 1) \== '' then call test_failed '18'
say '... DELWORD done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
