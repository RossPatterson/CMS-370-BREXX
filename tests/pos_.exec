/* POS */
say 'Testing POS ...'
fail_count=0
/* These from TRL2. */
if pos('day','Saturday') \= 6 then call test_failed '1'
if pos('x','abc def ghi') \= 0 then call test_failed '2'
if pos(' ','abc def ghi') \= 4 then call test_failed '3'
if pos(' ','abc def ghi',5) \= 8 then call test_failed '4'
/* These from Mark Hessling. */
if pos('foo','a foo foo b') \== 3 then call test_failed '5'
if pos('foo','a foo foo',3) \== 3 then call test_failed '6'
if pos('foo','a foo foo',4) \== 7 then call test_failed '7'
if pos('foo','a foo foo b',30) \== 0 then call test_failed '8'
if pos('foo','a foo foo b',1) \== 3 then call test_failed '9'
if pos('','a foo foo b') \== 0 then call test_failed '10'
if pos('foo','') \== 0 then call test_failed '11'
if pos('','') \== 0 then call test_failed '12'
if pos('b' , 'a') \== 0 then call test_failed '13'
if pos('b','b') \== 1 then call test_failed '14'
if pos('b','abc') \== 2 then call test_failed '15'
if pos('b','def') \== 0 then call test_failed '16'
if pos('foo','foo foo b') \== 1 then call test_failed '17'
say '... POS done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
