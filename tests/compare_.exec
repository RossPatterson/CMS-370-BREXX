/* COMPARE() */
say 'Testing COMPARE ...'
fail_count=0
/* These from TRL2. */
if compare('abc','abc') \= 0 then call test_failed '1'
if compare('abc','ak') \= 2 then call test_failed '2'
if compare('ab ','ab') \= 0 then call test_failed '3'
if compare('ab ','ab',' ') \= 0 then call test_failed '4'
if compare('ab ','ab','x') \= 3 then call test_failed '5'
if compare('ab-- ','ab','-') \= 5 then call test_failed '6'
/* These from Mark Hessling. */
if compare('foo', 'bar') \== 1 then call test_failed '7'
if compare('foo', 'foo') \== 0 then call test_failed '8'
if compare(' ', '' ) \== 0 then call test_failed '9'
if compare('foo', 'f', 'o') \== 0 then call test_failed '10'
if compare('foobar', 'foobag') \== 6 then call test_failed '11'
say '... COMPARE done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
