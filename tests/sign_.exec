/* SIGN */
say 'Testing SIGN ...'
fail_count=0
/* These from TRL2. */
if sign('12.3') \= 1 then call test_failed '1'
if sign(0.0) \= 0 then call test_failed '2'
if sign(' -0.307') \= -1 then call test_failed '3'
/* These from Mark Hessling. */
if sign('0') \== 0 then call test_failed '4'
if sign('-0') \== 0 then call test_failed '5'
if sign('0.4') \== 1 then call test_failed '6'
if sign('-10') \== -1 then call test_failed '7'
if sign('15') \== 1 then call test_failed '8'
say '... SIGN done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
