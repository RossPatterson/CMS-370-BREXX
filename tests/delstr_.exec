/* DELSTR */
say 'Testing DELSTR ...'
fail_count=0
/* These from TRL2. */
if delstr('abcd',3) \== 'ab' then call test_failed '1'
if delstr('abcde',3,2) \== 'abe' then call test_failed '2'
if delstr('abcde',6) \== 'abcde' then call test_failed '3'
/* These from Mark Hessling. */
if delstr('Med lov skal land bygges', 6) \== 'Med l' then call test_failed '4'
if delstr('Med lov skal land bygges', 6,10) \== 'Med lnd bygges' then call test_failed '5'
if delstr('Med lov skal land bygges', 1) \== '' then call test_failed '6'
if delstr('Med lov skal', 30) \== 'Med lov skal' then call test_failed '7'
if delstr('Med lov skal', 8 , 8) \== 'Med lov' then call test_failed '8'
if delstr('Med lov skal', 12) \== 'Med lov ska' then call test_failed '9'
if delstr('Med lov skal', 13) \== 'Med lov skal' then call test_failed '10'
if delstr('Med lov skal', 14) \== 'Med lov skal' then call test_failed '11'
if delstr('', 30) \== '' then call test_failed '12'
say '... DELSTR done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
