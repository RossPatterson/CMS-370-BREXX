interpreter ' length_'||suffix     ; fail_count=fail_count+rc
interpreter ' linein_'||suffix     ; fail_count=fail_count+rc
interpreter ' lineout_'||suffix    ; fail_count=fail_count+rc
interpreter ' lines_'||suffix      ; fail_count=fail_count+rc
interpreter ' maths_'||suffix      ; fail_count=fail_count+rc
interpreter ' max_'||suffix        ; fail_count=fail_count+rc
interpreter ' min_'||suffix        ; fail_count=fail_count+rc
