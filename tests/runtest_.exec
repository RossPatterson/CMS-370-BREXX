/* rexx tests */
parse arg interpreter
if interpreter='' then interpreter='rexx'
parse source source 1 system .
parse version rexx_version
say 'Rexx version' rexx_version 'on' system
suffix = '.exec'
if system='CMS' then
do
    suffix = ''
    interpreter = ''
    'CP SPOOL CONS * START'
end
fail_count=0
interpreter ' abbrev_'||suffix     ; fail_count=fail_count+rc
interpreter ' abs_'||suffix        ; fail_count=fail_count+rc
interpreter ' address_'||suffix    ; fail_count=fail_count+rc
           /* add_test */
interpreter ' arg_'||suffix        ; fail_count=fail_count+rc
           /* arithtst */
interpreter ' bitand_'||suffix     ; fail_count=fail_count+rc
interpreter ' bitor_'||suffix      ; fail_count=fail_count+rc
