interpreter ' delstr_'||suffix     ; fail_count=fail_count+rc
interpreter ' delword_'||suffix    ; fail_count=fail_count+rc
interpreter ' digits_'||suffix     ; fail_count=fail_count+rc
interpreter ' d2c_'||suffix        ; fail_count=fail_count+rc
interpreter ' d2x_'||suffix        ; fail_count=fail_count+rc
           /* errorms_ */
interpreter ' errorte_'||suffix    ; fail_count=fail_count+rc
