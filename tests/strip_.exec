/* STRIP */
say 'Testing STRIP ...'
fail_count=0
/* These from TRL2. */
if strip(' ab c ') \== 'ab c' then call test_failed '1'
if strip(' ab c ','L') \== 'ab c ' then call test_failed '2'
if strip(' ab c ','t') \== ' ab c' then call test_failed '3'
if strip('12.7000',,0) \== '12.7' then call test_failed '4'
if strip('0012.7000',,0) \== '12.7' then call test_failed '5'
/* These from Mark Hessling. */
if strip(' foo bar ') \== 'foo bar' then call test_failed '6'
if strip(' foo bar ','L') \== 'foo bar ' then call test_failed '7'
if strip(' foo bar ','T') \== ' foo bar' then call test_failed '8'
if strip(' foo bar ','B') \== 'foo bar' then call test_failed '9'
if strip(' foo bar ','B','*') \== ' foo bar ' then call test_failed '10'
if strip(' foo bar',,'r') \== ' foo ba' then call test_failed '11'
say '... STRIP done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
