/* OVERLAY */
say 'Testing OVERLAY ...'
fail_count=0
/* These from TRL2. */
if overlay('.','abcdef',3,2) \== 'ab. ef'         then call test_failed '1'
if overlay(' ','abcdef',3) \== 'ab def'           then call test_failed '2'
if overlay('.','abcdef',3,2) \== 'ab. ef'         then call test_failed '3'
if overlay('qq','abcd') \== 'qqcd'                then call test_failed '4'
if overlay('qq','abcd',4) \== 'abcqq'             then call test_failed '5'
if overlay('123','abc',5,6,'+') \== 'abc+123+++'  then call test_failed '6'
/* These from Mark Hessling. */
if overlay('foo', 'abcdefghi',3,4,'*') \==  'abfoo*ghi'  then call test_failed '7'
if overlay('foo', 'abcdefghi',3,2,'*') \==  'abfoefghi'  then call test_failed '8'
if overlay('foo', 'abcdefghi',3,4,) \==  'abfoo ghi'     then call test_failed '9'
if overlay('foo', 'abcdefghi',3) \==  'abfoofghi'        then call test_failed '10'
if overlay('foo', 'abcdefghi',,4,'*') \==  'foo*efghi'   then call test_failed '11'
if overlay('foo', 'abcdefghi',9,4,'*') \==  'abcdefghfoo*'  then call test_failed '12'
if overlay('foo', 'abcdefghi',10,4,'*') \==  'abcdefghifoo*'  then call test_failed '13'
if overlay('foo', 'abcdefghi',11,4,'*') \==  'abcdefghi*foo*'  then call test_failed '14'
if overlay('', 'abcdefghi',3) \==  'abcdefghi'                 then call test_failed '15'
if overlay('foo', '',3) \==  '  foo'                           then call test_failed '16'
if overlay('', '',3,4,'*') \==  '******'                       then call test_failed '17'
if overlay('', '') \==  ''                                     then call test_failed '18'
say '... OVERLAY done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
