/* RANDOM */
say 'Testing RANDOM ...'
fail_count=0
/* These from TRL2. */
say 'Values may differ.'
say 'RANDOM()='random()
say 'RANDOM(5,8)='random(5,8)
say 'RANDOM(,,1989)='random(,,1989)
say 'RANDOM(2)='random(2)
/* These from Mark Hessling. */
say '... RANDOM done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
