/* B2X() */
say 'Testing B2X ...'
fail_count=0
/* These from TRL2. */
if b2x('11000011') \== 'C3' then call test_failed '1'
if b2x('10111') \== '17' then call test_failed '2'
if b2x('101') \== '5' then call test_failed '3'
if b2x('1 1111 0000') \== '1F0' then call test_failed '4'
if x2d(b2x('10111')) \== '23' then call test_failed '5'
/* These from Mark Hessling. */
if b2x('') \== '' then call test_failed '6'
if b2x('0') \== '0' then call test_failed '7'
if b2x('1') \== '1' then call test_failed '8'
if b2x('10') \== '2' then call test_failed '9'
if b2x('010') \== '2' then call test_failed '10'
if b2x('1010') \== 'A' then call test_failed '11'
if b2x('1 0101') \== '15' then call test_failed '12'
if b2x('1 01010101') \== '155' then call test_failed '13'
if b2x('1 0101 0101') \== '155' then call test_failed '14'
if b2x('10101 0101') \== '155' then call test_failed '15'
if b2x('0000 00000000 0000') \== '0000' then call test_failed '16'
if b2x('11111111 11111111') \== 'FFFF' then call test_failed '17'
say '... B2X done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
