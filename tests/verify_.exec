/* VERIFY */
say 'Testing VERIFY ...'
fail_count=0
/* These from TRL2. */
if verify('123','1234567890') \= 0 then call test_failed '1'
if verify('1Z3','1234567890') \= 2 then call test_failed '2'
if verify('AB4T','1234567890','M') \= 3 then call test_failed '3'
if verify('1P3Q4','1234567890',,3) \= 4 then call test_failed '4'
if verify('ABCDE','',,3) \= 3 then call test_failed '5'
if verify('AB3CD5','1234567890','M',4) \= 6 then call test_failed '6'
/* These from Mark Hessling. */
if verify('foobar', 'barfo', N, 1) \== 0 then call test_failed '7'
if verify('foobar', 'barfo', M, 1) \== 1 then call test_failed '8'
if verify('', 'barfo') \== 0 then call test_failed '9'
if verify('foobar', '') \== 1 then call test_failed '10'
if verify('foobar', 'barf', N, 3) \== 3 then call test_failed '11'
if verify('foobar', 'barf', N, 4) \== 0 then call test_failed '12'
if verify('', '') \== 0 then call test_failed '13'
say '... VERIFY done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
