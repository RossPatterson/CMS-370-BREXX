/* SUBWORD */
say 'Testing SUBWORD ...'
fail_count=0
/* These from TRL2. */
if subword('Now is the time',2,2) \== 'is the' then call test_failed '1'
if subword('Now is the time',3) \== 'the time' then call test_failed '2'
if subword('Now is the time',5) \== '' then call test_failed '3'
/* These from Mark Hessling. */
if subword(' to be or not to be ',5) \== 'to be' then call test_failed '4'
if subword(' to be or not to be ',6) \== 'be' then call test_failed '5'
if subword(' to be or not to be ',7) \== '' then call test_failed '6'
if subword(' to be or not to be ',8,7) \== '' then call test_failed '7'
if subword(' to be or not to be ',3,2) \== 'or not' then call test_failed '8'
if subword(' to be or not to be ',1,2) \== 'to be' then call test_failed '9'
if subword(' to be or not to be ',4,2) \== 'not to' then call test_failed '10'
if subword('abc de f', 3) \== 'f' then call test_failed '11'
say '... SUBWORD done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
