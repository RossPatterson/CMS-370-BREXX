/* X2B */
say 'Testing X2B ...'
fail_count=0
/* These from TRL2. */
if x2b('C3') \== '11000011' then call test_failed '1'
if x2b('7') \== '0111' then call test_failed '2'
if x2b('1 C1') \== '000111000001' then call test_failed '3'
if x2b(c2x('C3'x)) \== '11000011' then call test_failed '4'
if x2b(d2x('129')) \== '10000001' then call test_failed '5'
if x2b(d2x('12')) \== '1100' then call test_failed '6'
/* These from Mark Hessling. */
if x2b('416263') \== '010000010110001001100011' then call test_failed '7'
if x2b('DeadBeef') \== '11011110101011011011111011101111' then call test_failed '8'
if x2b('1 02 03') \== '00010000001000000011' then call test_failed '9'
if x2b('102 03') \== '00010000001000000011' then call test_failed '10'
if x2b('102') \== '000100000010' then call test_failed '11'
if x2b('11 2F') \== '0001000100101111' then call test_failed '12'
if x2b('') \== '' then call test_failed '13'
say '... X2B done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
