/* SPACE */
say 'Testing SPACE ...'
fail_count=0
/* These from TRL2. */
if space('abc  def  ') \== 'abc def'         then call test_failed '1'
if space('  abc  def',3) \== 'abc   def'     then call test_failed '2'
if space('abc  def  ',1) \== 'abc def'       then call test_failed '3'
if space('abc  def  ',0) \== 'abcdef'        then call test_failed '4'
if space('abc  def  ',2,'+') \== 'abc++def'  then call test_failed '5'
/* These from Mark Hessling. */
if space(' foo ')                \== 'foo'                then call test_failed '6'
if space('  foo')                \== 'foo'                then call test_failed '7'
if space('foo  ')                \== 'foo'                then call test_failed '8'
if space('  foo  ')              \== 'foo'                then call test_failed '9'
if space(' foo bar ')            \== 'foo bar'            then call test_failed '10'
if space('  foo  bar  ')         \== 'foo bar'            then call test_failed '11'
if space(' foo bar ' , 2)          \== 'foo  bar'         then call test_failed '12'
if space(' foo bar ',,'-')       \== 'foo-bar'            then call test_failed '13'
if space('  foo  bar  ',2,'-')   \== 'foo--bar'           then call test_failed '14'
if space(' f-- b-- ',2,'-')      \== 'f----b--'           then call test_failed '15'
if space(' f o o   b a r ',0)    \== 'foobar'             then call test_failed '16'
say '... SPACE done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
