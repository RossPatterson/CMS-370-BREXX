/* VALUE */
say 'Testing VALUE ...'
fail_count=0
/* These from TRL2. */
drop A3; A33=7; K=3; fred='K'; list.5='?'
if value('a'k)\=='A3' then call test_failed '1'
if value('a'k||k)\=='7' then call test_failed '2'
if value('fred')\=='K' then call test_failed '3'
if value(fred)\=='3' then call test_failed '4'
if value(fred,5)\=='3' then call test_failed '5'
if value(fred)\=='5' then call test_failed '6'
if value('LIST.'k)\=='?' then call test_failed '7'
/* These from Mark Hessling. */
x.a = 'asdf'
x.b = 'foo'
x.c = 'A'
a = 'B'
b = 'C'
c = 'A'
if value('a')\=='B' then call test_failed '8'
if value(a)\=='C' then call test_failed '9'
if value(c)\=='B' then call test_failed '10'
if value('c')\=='A' then call test_failed '11'
if value('x.A')\=='foo' then call test_failed '12'
if value(x.B)\=='B' then call test_failed '13'
if value('x.B')\=='A' then call test_failed '14'
if value('x.'||a)\=='A' then call test_failed '15'
if value(value(x.b))\=='C' then call test_failed '16'
xyzzy = 'foo'
if value('xyzzy')\=='foo' then call test_failed '17'
if value('xyzzy','bar')\=='foo' then call test_failed '18'
if value('xyzzy')\=='bar' then call test_failed '19'
if value('xyzzy','bar')\=='bar' then call test_failed '20'
if value('xyzzy')\=='bar' then call test_failed '21'
if value('xyzzy','foo')\=='bar' then call test_failed '22'
if value('xyzzy')\=='foo' then call test_failed '23'
xyzzy = 'void'
if os = 'UNIX' Then
envvar = '$xyzzy'
else
envvar = '%xyzzy%'
/* System dependent
call value 'xyzzy', 'bar', 'SYSTEM'
if value('xyzzy', 'bar', 'SYSTEM')\=='bar' then call test_failed '24'
if value('xyzzy',, 'SYSTEM')\=='bar' then call test_failed '25'
if value('xyzzy', , 'SYSTEM')\=='echo'(envvar) then call test_failed '26'
if value('xyzzy', 'foo', 'SYSTEM')\=='bar' then call test_failed '27'
if value('xyzzy', 'bar', 'SYSTEM')\=='foo' then call test_failed '28'
if value('xyzzy', , 'SYSTEM')\=='echo'(envvar) then call test_failed '29'
if value('xyzzy', , 'SYSTEM')\=='bar' then call test_failed '30'
if value('xyzzy', 'foo', 'SYSTEM')\=='bar' then call test_failed '31'
if value('xyzzy', , 'SYSTEM')\=='echo'(envvar) then call test_failed '32'
*/
say '... VALUE done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
