/* D2X */
say 'Testing D2X ...'
fail_count=0
/* These from TRL2. */
if d2x(9) \== '9' then call test_failed '1'
if d2x(129) \== '81' then call test_failed '2'
if d2x(129,1) \== '1' then call test_failed '3'
if d2x(129,2) \== '81' then call test_failed '4'
if d2x(129,4) \== '0081' then call test_failed '5'
if d2x(257,2) \== '01' then call test_failed '6'
if d2x(-127,2) \== '81' then call test_failed '7'
if d2x(-127,4) \== 'FF81' then call test_failed '8'
if d2x(12,0) \== '' then call test_failed '9'
/* These from Mark Hessling. */
/* if d2x(0) \== '' then call test_failed '10' */
if d2x(127) \== '7F' then call test_failed '11'
if d2x(128) \== '80' then call test_failed '12'
if d2x(129) \== '81' then call test_failed '13'
if d2x(1) \== '1' then call test_failed '14'
if d2x(-1,2) \== 'FF' then call test_failed '15'
if d2x(-127,2) \== '81' then call test_failed '16'
if d2x(-128,2) \== '80' then call test_failed '17'
if d2x(-129,2) \== '7F' then call test_failed '18'
if d2x(-1,3) \== 'FFF' then call test_failed '19'
if d2x(-127,3) \== 'F81' then call test_failed '20'
if d2x(-128,4) \== 'FF80' then call test_failed '21'
if d2x(-129,5) \== 'FFF7F' then call test_failed '22'
if d2x(129,0) \== '' then call test_failed '23'
if d2x(129,2) \== '81' then call test_failed '24'
if d2x(256+129,4) \== '0181' then call test_failed '25'
if d2x(256*256+256+129,6) \== '010181' then call test_failed '26'
say '... D2X done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
