/* MAX */
say 'Testing MAX ...'
fail_count=0
/* These from TRL2. */
if max(12,6,7,9) \= 12 then call test_failed '1'
if max(17.3,19,17.03) \= 19 then call test_failed '2'
if max(-7,-3,-4.3) \= -3 then call test_failed '3'
/* These from Mark Hessling. */
if max( 10.1 ) \== '10.1' then call test_failed '4'
if max( -10.1, 3.8 ) \== '3.8' then call test_failed '5'
if max( 10.1, 10.2, 10.3 ) \== '10.3' then call test_failed '6'
if max( 10.3, 10.2, 10.3 ) \== '10.3' then call test_failed '7'
if max( 10.1, 10.2, 10.3 ) \== '10.3' then call test_failed '8'
if max( 10.1, 10.4, 10.3 ) \== '10.4' then call test_failed '9'
if max( 10.3, 10.2, 10.1 ) \== '10.3' then call test_failed '10'
if max( 1, 2, 4, 5 ) \== '5' then call test_failed '11'
if max( -0, 0 ) \== '0' then call test_failed '12'
if max( 1,2,3,4,5,6,7,8,7,6,5,4,3,2 ) \== '8' then call test_failed '13'
say '... MAX done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
