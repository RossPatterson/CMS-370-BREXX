/* LASTPOS */
say 'Testing LASTPOS ...'
fail_count=0
/* These from TRL2. */
if lastpos(' ','abc def ghi') \= 8 then call test_failed '1'
if lastpos(' ','abcdefghi') \= 0 then call test_failed '2'
if lastpos(' ','abc def ghi',7) \= 4 then call test_failed '3'
/* These from Mark Hessling. */
if lastpos('b', 'abc abc') \== 6 then call test_failed '4'
if lastpos('b', 'abc abc',5) \== 2 then call test_failed '5'
if lastpos('b', 'abc abc',6) \== 6 then call test_failed '6'
if lastpos('b', 'abc abc',7) \== 6 then call test_failed '7'
if lastpos('x', 'abc abc') \== 0 then call test_failed '8'
if lastpos('b', 'abc abc',20) \== 6 then call test_failed '9'
if lastpos('b', '') \== 0 then call test_failed '10'
if lastpos('', 'c') \== 0 then call test_failed '11'
if lastpos('', '') \== 0 then call test_failed '12'
if lastpos('b', 'abc abc',20) \== 6 then call test_failed '13'
if lastpos('bc', 'abc abc') \== 6 then call test_failed '14'
if lastpos('bc ', 'abc abc',20) \== 2 then call test_failed '15'
if lastpos('abc', 'abc abc',6) \== 1 then call test_failed '16'
if lastpos('abc', 'abc abc') \== 5 then call test_failed '17'
if lastpos('abc', 'abc abc',7) \== 5 then call test_failed '18'
/* These from elsewhere. */
if pos('abc','abcdefabccdabcd',4) \== 7 then call test_failed '19'
say '... LASTPOS done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
