/* TRACE */
parse source system .
if system = 'CMS' then suffix = ''
else suffix = '.exec'

say "Look for TRACE OK"

/* These from the Rexx book. */
if trace() \== 'N' then say 'failed in test 1'
if trace('O') \== 'N' then say 'failed in test 2'
if trace('A') \== 'O' then say 'failed in test 3'
if trace('F') \== 'A' then say 'failed in test 4'
if trace() \== 'F' then say 'failed in test 5'

trace O

trace N
if trace() \== 'N' then say 'failed in test 6'
say 'test 6 expecting a trace'
'exitneg_' || suffix
if RC >=0 then say 'failed in test 6'
else say 'was there one?'

trace N
if trace() \== 'N' then say 'failed in test 7'
say 'test 7 expecting no trace'
'exitok_' || suffix
if RC <=0 then say 'failed in test 7'
else say 'was there one?'

trace N
