/* TRACE */
parse arg sentinel retcode .
if sentinel == '$$$' then exit retcode

parse source . . my_name .

say "Look for TRACE OK"

/* These from the Rexx book. */
if trace() \== 'N' then say 'failed in test 1'
if trace('O') \== 'N' then say 'failed in test 2'
if trace('A') \== 'O' then say 'failed in test 3'
if trace('F') \== 'A' then say 'failed in test 4'
if trace() \== 'F' then say 'failed in test 5'

trace N
if trace() \== 'N' then say 'failed in test 6'
say 'expecting a trace'
my_name '$$$' '-99'
if RC >=0 then say 'failed in test 6'
else say 'was there one?'

trace N
if trace() \== 'N' then say 'failed in test 7'
say 'expecting no trace'
my_name '$$$' '99'
if RC <=0 then say 'failed in test 7'
else say 'was there one?'

trace F
if trace() \== 'F' then say 'failed in test 8'
say 'expecting a trace'
my_name '$$$' '-99'
if RC >=0 then say 'failed in test 8'
else say 'was there one?'

trace F
if trace() \== 'F' then say 'failed in test 9'
say 'expecting no trace'
my_name '$$$' '99'
if RC <=0 then say 'failed in test 9'
else say 'was there one?'

trace E
if trace() \== 'E' then say 'failed in test 10'
say 'expecting no trace'
my_name '$$$' '-99'
if RC >=0 then say 'failed in test 10'
else say 'was there one?'

trace E
if trace() \== 'E' then say 'failed in test 11'
say 'expecting a trace'
my_name '$$$' '99'
if RC <=0 then say 'failed in test 11'
else say 'was there one?'

say "TRACE OK"
