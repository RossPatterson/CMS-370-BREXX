/* COPIES() */
say 'Testing COPIES ...'
fail_count=0
/*These from TRL2. */
if copies('abc',3) \== 'abcabcabc' then call test_failed '1'
if copies('abc',0) \== '' then call test_failed '2'
/* These from Mark Hessling. */
if copies('foo',3) \== 'foofoofoo' then call test_failed '3'
if copies('x', 10) \== 'xxxxxxxxxx' then call test_failed '4'
if copies('', 50) \== '' then call test_failed '5'
if copies('', 0) \== '' then call test_failed '6'
if copies('foobar',0 ) \== '' then call test_failed '7'
say '... COPIES done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
