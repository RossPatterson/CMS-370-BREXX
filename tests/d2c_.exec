/* D2C */
say 'Testing D2C ...'
fail_count=0
/* These from TRL2. */
if d2c(9) \== '09'x then call test_failed '1'
if d2c(129) \== '81'x then call test_failed '2'
if d2c(129,1) \== '81'x then call test_failed '3'
if d2c(129,2) \== '0081'x then call test_failed '4'
if d2c(257,1) \== '01'x then call test_failed '5'
if d2c(-127,1) \== '81'x then call test_failed '6'
if d2c(-127,2) \== 'FF81'x then call test_failed '7'
if d2c(-1,4) \== 'FFFFFFFF'x then call test_failed '8'
if d2c(12,0) \== '' then call test_failed '9'
/* These from Mark Hessling. */
if d2c(127) \== '7f'x then call test_failed '10'
if d2c(128) \== '80'x then call test_failed '11'
if d2c(129) \== '81'x then call test_failed '12'
if d2c(1) \== '01'x then call test_failed '13'
if d2c(-1,1) \== 'FF'x then call test_failed '14'
if d2c(-127,1) \== '81'x then call test_failed '15'
if d2c(-128,1) \== '80'x then call test_failed '16'
if d2c(-129,1) \== '7F'x then call test_failed '17'
if d2c(-1,2) \== 'FFFF'x then call test_failed '18'
if d2c(-127,2) \== 'FF81'x then call test_failed '19'
if d2c(-128,2) \== 'FF80'x then call test_failed '20'
if d2c(-129,2) \== 'FF7F'x then call test_failed '21'
if d2c(129,0) \== '' then call test_failed '22'
if d2c(129,1) \== '81'x then call test_failed '23'
if d2c(256+129,2) \== '0181'x then call test_failed '24'
if d2c(256*256+256+129,3) \== '010181'x then call test_failed '25'
say '... D2C done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
