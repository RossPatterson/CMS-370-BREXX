/* WORDPOS */
say 'Testing WORDPOS ...'
fail_count=0
/* These from TRL2. */
if wordpos('the','Now is the time') \= 3 then call test_failed '1'
if wordpos('The','Now is the time') \= 0 then call test_failed '2'
if wordpos('is the','Now is the time') \= 2 then call test_failed '3'
if wordpos('is the','Now is the time') \= 2 then call test_failed '4'
if wordpos('be','To be or not to be') \= 2 then call test_failed '5'
if wordpos('be','To be or not to be',3) \= 6 then call test_failed '6'
/* These from Mark Hessling. */
if wordpos('This','This is a small test') \== 1 then call test_failed '7'
if wordpos('test','This is a small test') \== 5 then call test_failed '8'
if wordpos('foo','This is a small test') \== 0 then call test_failed '9'
if wordpos(' This ','This is a small test') \== 1 then call test_failed '10'
if wordpos('This',' This is a small test') \== 1 then call test_failed '11'
if wordpos('This','This is a small test') \== 1 then call test_failed '12'
if wordpos('This','this is a small This') \== 5 then call test_failed '13'
if wordpos('This','This is a small This') \== 1 then call test_failed '14'
if wordpos('This','This is a small This', 2) \== 5 then call test_failed '15'
if wordpos('is a ','This is a small test') \== 2 then call test_failed '16'
if wordpos('is a ','This is a small test') \== 2 then call test_failed '17'
if wordpos(' is a ','This is a small test') \== 2 then call test_failed '18'
if wordpos('is a ','This is a small test', 2) \== 2 then call test_failed '19'
if wordpos('is a ','This is a small test',3) \== 0 then call test_failed '20'
if wordpos('is a ','This is a small test',4) \== 0 then call test_failed '21'
if wordpos('test ','This is a small test') \== 5 then call test_failed '22'
if wordpos('test ','This is a small test',5) \== 5 then call test_failed '23'
if wordpos('test ','This is a small test',6) \== 0 then call test_failed '24'
if wordpos('test ','This is a small test ') \== 5 then call test_failed '25'
if wordpos(' test','This is a small test ',6) \== 0 then call test_failed '26'
if wordpos('test ','This is a small test ',5) \== 5 then call test_failed '27'
if wordpos(' ','This is a small test') \== 0 then call test_failed '28'
if wordpos(' ','This is a small test',3) \== 0 then call test_failed '29'
if wordpos('','This is a small test',4) \== 0 then call test_failed '30'
if wordpos('test ','') \== 0 then call test_failed '31'
if wordpos('','') \== 0 then call test_failed '32'
if wordpos('',' ') \== 0 then call test_failed '33'
if wordpos(' ','') \== 0 then call test_failed '34'
if wordpos(' ','', 3) \== 0 then call test_failed '35'
if wordpos(' a ','') \== 0 then call test_failed '36'
if wordpos(' a ','a') \== 1 then call test_failed '37'
say '... WORDPOS done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
