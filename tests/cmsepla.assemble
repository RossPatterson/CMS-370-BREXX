T007CODE DS    0D
   $L '/* CMSEPL7 EXEC - See CMSEPLA ASSEMBLE:TEST7. */'
   $L 'Parse version Version'
   $L 'Say "TEST7 running on" Version'
   $L 'Parse source System Environment FN FT FM Command Prefix'
   $L 'If System <> "CMS" then Return 1'
   $L 'If Environment <> "COMMAND" then Return 2'
   $L 'If (FN FT) <> "CMSepL7 TESTEXEC" | ,'
   $L '   (Translate(FM) <> "A1" && FM <> "*") then Return 3'
   $L 'If Command <> "TesTNopQ" then Return 4'
   $L 'If Prefix <> "BLIVET" then Return 5'
   $L ' '
   $L 'Parse arg Word1 Word2 Word3'
   $L 'If Word1 <> "LongArgIjkl" then Return 6'
   $L 'If Word2 <> "QuiteALongArg" then Return 7'
   $L 'If Word3 <> "" then Return 8'
   $L 'If Address() <> "BLIVET" then Return 9'
