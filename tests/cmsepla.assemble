         DC    A(T007FBLK)    -> FBLOCK
         SPACE 3
T007TPL  DS    0D
T007VERB DC    CL8'EXEC'
         DC    CL8'tEsTiJkL'  Will be overridden by FBLNAME & EPLARGBG.
         DC    8X'FF'
         SPACE 3
T007FBLK DS    0D
         DC    CL8'CMSepL7'   Fn.
         DC    CL8'TESTEXEC'  Ft.
         DC    CL2'*'         Fm.
         DC    AL2((T007FBLE-(*+2))/4) L'extension list in words
         DC    A(T007CODE)    Ext 1: First line.
         DC    A(T007CODL)    Ext 1: Length of list.
         DC    CL8'BANANA'    Ext 2: "Prefix" (i.e., ADDRESS()).
         DC    CL8'BLIVET'    Ext 3: Environment.
T007FBLE EQU   *
         SPACE 3
T007ARG1 DC    C'TesTNopQ LongArgIjkl QuiteALongArg'
