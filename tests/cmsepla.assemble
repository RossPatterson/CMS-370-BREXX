T007CODL EQU   *-T007CODE
         TITLE 'TEST8 - Run an EXEC that issues commands to a PSW env.'
TEST8    DS    0H
         LA    R0,T008EPL
         LA    R1,T008TPL
         ICM   R1,B'1000',=X'0B' 4-word EPlist available
         L     R2,=X'FADEDBEE'
*
* No option for SVC linkage here - this always calls BALR-style, to be
* able to check passing of R2.
*
         BAL   R14,BALREXEC
         CH    R15,=H'108'    Did we get expected RC?
         BE    EXITOK         Yes, all is well
         BAL   R14,MSG002     "Unexpected RC"
         B     EXITRC         Tell caller we failed.
         SPACE 3
         PUSH  USING
         DROP  ,
T008ENV  DS    0H
         STM   R0,R15,0(R13)
         BALR  R12,0
         USING *,R12
         LR    R11,R14
         LR    R4,R0
         LR    R5,R1
         C     R6,=X'FADEDBEE'
         BNE   T008ENV2
         LINEDIT TEXT='Expected R2=FADEDBEE',DOT=NO
T008ENV2 DS    0H
         AGO   .T008EN4        Turn this off for debugging.
         LR    R6,R2
         LINEDIT TEXT='R0=........ R1=........ R2=........ R13=........*
                R14=........',                                         *
               SUB=(HEX,(R4),HEX,(R5),HEX,(R6),HEX,(R13),HEX,(R11)),   *
               RENT=NO,DOT=NO
         LINEDIT TEXT='EPLIST=.........................................*
               ............',                                          *
               SUB=(HEX4A,(R4)),RENT=NO,DOT=NO
         L     R2,0(,R4)
         LINEDIT TEXT='EPLCMD=.................',                      *
               SUB=(HEX4A,(R2)),RENT=NO,DOT=NO
         CLC   0(8,R2),T008PSW
         BE    T008ENV3
         LINEDIT TEXT='Expected EPLCMD=.................',             *
               SUB=(HEX4A,T008PSW),RENT=NO,DOT=NO
T008ENV3 DS    0H
         L     R3,4(,R4)
         L     R6,8(,R4)
         SR    R6,R3
         LINEDIT TEXT='EPLARGS=........................................*
               ......................................................',*
               SUB=(CHARA,((R3),(R6))),RENT=NO,DOT=NO
         LINEDIT TEXT='TPLIST=.........................................*
               ......................',                                *
               SUB=(CHAR8A,(R5)),RENT=NO,DOT=NO,COMP=NO
.T008EN4 ANOP  ,
         WAITT ,
         LM    R0,R14,0(R13)
         LA    R15,42
         BR    R14
         POP   USING
         SPACE 3
T008EPL  DS    0D
         DC    A(T008VERB)    Cmd.
         DC    A(T008ARG1)    Argstart.
         DC    A(T008ARGE)    Argend.
         DC    A(T008FBLK)    -> FBLOCK
         SPACE 3
T008TPL  DS    0D
T008VERB DC    CL8'EXEC'
         DC    CL8'tEsTMnOp'  Will be overridden by FBLNAME & EPLARGBG.
         DC    8X'FF'
         SPACE 3
T008FBLK DS    0D
         DC    CL8'CMSEpl8'   Fn.
         DC    CL8'TESTEXEC'  Ft.
         DC    CL2'*'         Fm.
         DC    AL2((T008FBLE-(*+2))/4) L'extension list in words
         DC    A(T008CODE)    Ext 1: First line.
         DC    A(T008CODL)    Ext 1: Length of list.
T008PSW  DC    A(0,T008ENV)   Ext 2: "Prefix" (i.e., ADDRESS()).
T008FBLE EQU   *
         SPACE 3
T008ARG1 DC    C'TesTmNoP LongArgIjkl QuiteALongArg'
T008ARGE EQU   *
         SPACE 3
T008CODE DS    0D
   $L '/* CMSEPL8 EXEC - See CMSEPLA ASSEMBLE:TEST8. */'
   $L 'Parse version Version'
   $L 'Say "TEST8 running on" Version'
   $L 'Parse source System Environment FN FT FM Command Prefix'
   $L 'If System <> "CMS" then Return 1'
   $L 'If Environment <> "COMMAND" then Return 2'
   $L 'If (FN FT) <> "CMSEpl8 TESTEXEC" | ,'
   $L '   (Translate(FM) <> "A1" && FM <> "*") then Return 3'
   $L 'If Command <> "TesTmNoP" then Return 4'
   $L ' '
   $L 'Parse arg Word1 Word2 Word3'
   $L 'If Word1 <> "LongArgIjkl" then Return 5'
   $L 'If Word2 <> "QuiteALongArg" then Return 6'
   $L 'If Word3 <> "" then Return 7'
   $L 'If C2X(Left(Address(), 1)) <> "00" then Return 8'
   $L ' '
   $L '"TESTASDF ABC 123 NowIsTheWinterOfOurDiscontent" ,'
   $L '   "MadeGloriousSummerByThisSonOfYork"'
   $L ' '
   $L 'If RC <> 42 then Return 9'
   $L 'If SourceLine() <> 24 then Return 10'
   $L ' '
   $L '/* Tell CMSEPLA we succeeded. */'
   $L 'Return 108'
T008CODL EQU   *-T008CODE
         TITLE 'TEST9 - Run an EXEC odd filetype and function calls.'
TEST9    DS    0H
         LA    R0,T009EPL
         LA    R1,T009TPL
         ICM   R1,B'1000',=X'0B' 4-word EPlist available
         BAL   R14,RUNEXEC
         CH    R15,=H'109'    Did we get expected RC?
         BE    EXITOK         Yes, all is well
         BAL   R14,MSG002     "Unexpected RC"
         B     EXITRC         Tell caller we failed.
         SPACE 3
T009EPL  DS    0D
         DC    A(T009VERB)    Cmd.
         DC    A(T009ARG1)    Argstart.
         DC    A(T009ARGE)    Argend.
         DC    A(T009FBLK)    -> FBLOCK
         SPACE 3
T009TPL  DS    0D
T009VERB DC    CL8'EXEC'
         DC    CL8'TesTyYzZ'  Will be overridden by FBLNAME & EPLARGBG.
         DC    CL8'ThisIsAVeryBigArgument'
         DC    CL8'ThisOneIsToo'
         DC    8X'FF'
         SPACE 3
T009FBLK DS    0D
         DC    CL8'CMSEPL9'  Fn.
         DC    CL8'TESTEXEC'  Ft.
         DC    CL2'*'         Fm.
         DC    AL2((T009FBLE-(*+2))/4) L'extension list in words
T009FBLE EQU   *
         SPACE 3
T009ARG1 DC    C'TestAsDf ThisIsAVeryBigArgument ThisOneIsToo'
T009ARGE EQU   *
         TITLE 'Messages'
MSG001   DS    0H
         XC    WRKLEDPL,WRKLEDPL
         LINEDIT TEXT='TSTEPL001E Unknown test name: ........',        *
               SUB=(CHARA,8(R3)),DISP=ERRMSG,MF=(E,WRKLEDPL)
         LA    R15,1
         BR    R14
         SPACE 3
MSG002   DS    0H
         LR    R2,R15
         LINEDIT TEXT='TSTEPL002E Unexpected return code ........',    *
               SUB=(DEC,(R2)),DISP=ERRMSG,MF=(E,WRKLEDPL)
         LA    R15,2
         BR    R14
         SPACE 3
         TITLE 'Constants'
         LTORG ,
         TITLE 'Work Area'
WRKAREA  DS    0D
WRKSAV1  DS    18A            Savearea.
DOUB     DS    D              Doubleword work area.
WRKUSAVE DS    A              -> CMS's USERSAVE at entry to us.
WRKPLST0 DS    0D
WRKLEDPL LINEDIT MAXSUBS=1,MF=L
WRKPLSTS EQU   WRKPLST0,*-WRKPLST0
         DS    0D
WRKSAV2  DS    XL256          Savearea across bREXX calls.
WRKLEN   EQU   *-WRKAREA
         TITLE 'DSECTs'
         NUCON ,
         ORG   NUCON+X'90'
NUCBREXX DS    A              bREXX address in memory
         ORG   ,
         EJECT ,
         IO    ,
         REGEQU ,
         END   ,
