/* rexx tests for truncate BIF. Runs without error on REXX370 4.02, ooRexx, Regina */
say 'Testing TRUNC ...'
fail_count=0
/* These from TRL2. */
if trunc(12.3)\==12 then call test_failed '1'
if trunc(127.09782,3)\==127.097 then call test_failed '2'
if trunc(127.1,3)\==127.100 then call test_failed '3'
/* if trunc(127.2)\==127.00 then call test_failed '4'  struck off after conferring with Walter */
/* These from Mark Hessling. */
if trunc(1234.5678, 2)\=='1234.56' then call test_failed '5'
if trunc(-1234.5678)\=='-1234' then call test_failed '6'
if trunc(.5678)\=='0' then call test_failed '7'
if trunc(.00123)\=='0' then call test_failed '8'
if trunc(.00123,4)\=='0.0012' then call test_failed '9'
if trunc(.00127,4)\=='0.0012' then call test_failed '10'
if trunc(.1678)\=='0' then call test_failed '11'
if trunc(1234.5678)\=='1234' then call test_failed '12'
if trunc(4.5678, 7)\=='4.5678000' then call test_failed '13'
if trunc(10000005.0,2)\==10000005.00 then call test_failed '14'
if trunc(10000000.5,2)\==10000000.50 then call test_failed '15'
if trunc(10000000.05,2)\==10000000.10 then call test_failed '16'
if trunc(10000000.005,2)\==10000000.00 then call test_failed '17'
if trunc(10000005.5,2)\==10000005.50 then call test_failed '18'
if trunc(10000000.55,2)\==10000000.60 then call test_failed '19'
if trunc(10000000.055,2)\==10000000.10 then call test_failed '20'
if trunc(10000000.0055,2)\==10000000.00 then call test_failed '21'
if trunc(10000000.04,2)\==10000000.00 then call test_failed '22'
if trunc(10000000.045,2)\==10000000.00 then call test_failed '23'
if trunc(10000000.45,2)\==10000000.50 then call test_failed '24'
/* Duplicates of test 16
if trunc(10000000.05,2)\==10000000.10 then call test_failed '25'
if trunc(10000000.05,2)\==10000000.10 then call test_failed '26'
if trunc(10000000.05,2)\==10000000.10 then call test_failed '27'
*/
if trunc(99999999.,2)\==99999999.00 then call test_failed '28'
if trunc(99999999.9,2)\==99999999.90 then call test_failed '29'
if trunc(99999999.99,2)\==100000000.00 then call test_failed '30'
if trunc(1E2,0)\==100 then call test_failed '31'
if trunc(12E1,0)\==120 then call test_failed '32'
if trunc(123.,0)\==123 then call test_failed '33'
if trunc(123.1,0)\==123 then call test_failed '34'
if trunc(123.12,0)\==123 then call test_failed '35'
if trunc(123.123,0)\==123 then call test_failed '36'
if trunc(123.1234,0)\==123 then call test_failed '37'
if trunc(123.12345,0)\==123 then call test_failed '38'
if trunc(1E2,1)\==100.0 then call test_failed '39'
if trunc(12E1,1)\==120.0 then call test_failed '40'
if trunc(123.,1)\==123.0 then call test_failed '41'
if trunc(123.1,1)\==123.1 then call test_failed '42'
if trunc(123.12,1)\==123.1 then call test_failed '43'
if trunc(123.123,1)\==123.1 then call test_failed '44'
if trunc(123.1234,1)\==123.1 then call test_failed '45'
if trunc(123.12345,1)\==123.1 then call test_failed '46'
if trunc(1E2,2)\==100.00 then call test_failed '47'
if trunc(12E1,2)\==120.00 then call test_failed '48'
if trunc(123.,2)\==123.00 then call test_failed '49'
if trunc(123.1,2)\==123.10 then call test_failed '50'
if trunc(123.12,2)\==123.12 then call test_failed '51'
if trunc(123.123,2)\==123.12 then call test_failed '52'
if trunc(123.1234,2)\==123.12 then call test_failed '53'
if trunc(123.12345,2)\==123.12 then call test_failed '54'
if trunc(1E2,3)\==100.000 then call test_failed '55'
if trunc(12E1,3)\==120.000 then call test_failed '56'
if trunc(123.,3)\==123.000 then call test_failed '57'
if trunc(123.1,3)\==123.100 then call test_failed '58'
if trunc(123.12,3)\==123.120 then call test_failed '59'
if trunc(123.123,3)\==123.123 then call test_failed '60'
if trunc(123.1234,3)\==123.123 then call test_failed '61'
if trunc(123.12345,3)\==123.123 then call test_failed '62'
if trunc(1E2,4)\==100.0000 then call test_failed '63'
if trunc(12E1,4)\==120.0000 then call test_failed '64'
if trunc(123.,4)\==123.0000 then call test_failed '65'
if trunc(123.1,4)\==123.1000 then call test_failed '66'
if trunc(123.12,4)\==123.1200 then call test_failed '67'
if trunc(123.123,4)\==123.1230 then call test_failed '68'
if trunc(123.1234,4)\==123.1234 then call test_failed '69'
if trunc(123.12345,4)\==123.1234 then call test_failed '70'
if trunc(1E2,5)\==100.00000 then call test_failed '71'
if trunc(12E1,5)\==120.00000 then call test_failed '72'
if trunc(123.,5)\==123.00000 then call test_failed '73'
if trunc(123.1,5)\==123.10000 then call test_failed '74'
if trunc(123.12,5)\==123.12000 then call test_failed '75'
if trunc(123.123,5)\==123.12300 then call test_failed '76'
if trunc(123.1234,5)\==123.12340 then call test_failed '77'
if trunc(123.12345,5)\==123.12345 then call test_failed '78'
say '... TRUNC done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
