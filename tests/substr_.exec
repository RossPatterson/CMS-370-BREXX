/* SUBSTR */
say 'Testing SUBSTR ...'
fail_count=0
/* These from TRL2. */
if substr('abc',2) \== 'bc'            then call test_failed '1'
if substr('abc',2,4) \== 'bc  '        then call test_failed '2'
if substr('abc',2,6,'.') \== 'bc....'  then call test_failed '3'
/* These from Mark Hessling. */
if substr('foobar',2,3) \==   'oob'                 then call test_failed '4'
if substr('foobar',3) \==   'obar'                  then call test_failed '5'
if substr('foobar',3,6) \==   'obar  '              then call test_failed '6'
if substr('foobar',3,6,'*') \==   'obar**'          then call test_failed '7'
if substr('foobar',6,3) \==   'r  '                 then call test_failed '8'
if substr('foobar',8,3) \==   '   '                 then call test_failed '9'
say '... SUBSTR done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
