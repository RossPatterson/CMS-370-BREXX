/* INSERT */
say 'Testing INSERT ...'
fail_count=0
/* These from TRL2. */
if insert(' ','abcdef',3) \== 'abc def' then call test_failed '1'
/* if insert('123','abc',5,6) \== 'abc 123 ' then call test_failed '2' */
if insert('123','abc',5,6,'+') \== 'abc++123+++' then call test_failed '3'
if insert('123','abc') \== '123abc' then call test_failed '4'
if insert('123','abc',,5,'-') \== '123--abc' then call test_failed '5'
/* These from Mark Hessling. */
if insert('abc','def') \== 'abcdef' then call test_failed '6'
if insert('abc','def',2) \== 'deabcf' then call test_failed '7'
if insert('abc','def',3) \== 'defabc' then call test_failed '8'
/* if insert('abc','def',5) \== 'def abc' then call test_failed '9' */
if insert('abc','def',5,,'*') \== 'def**abc' then call test_failed '10'
if insert('abc' ,'def',5,4,'*') \== 'def**abc*' then call test_failed '11'
if insert('abc','def',,0) \== 'def' then call test_failed '12'
if insert('abc','def',2,1) \== 'deaf' then call test_failed '13'
say '... INSERT done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
