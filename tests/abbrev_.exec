/* ABBREV */
say 'Testing ABBREV ...'
fail_count=0
/* These from TRL2. */
if \abbrev('Print','Pri') then call test_failed '1'
if abbrev('PRINT','Pri') then call test_failed '2'
if abbrev('PRINT','PRI',4) then call test_failed '3'
if abbrev('PRINT','PRY') then call test_failed '4'
if \abbrev('PRINT','') then call test_failed '5'
if abbrev('PRINT','',1) then call test_failed '6'
/* These from Mark Hessling. */
if \abbrev('information','info',4) then call test_failed '7'
if \abbrev('information','',0) then call test_failed '8'
if abbrev('information','Info',4) then call test_failed '9'
if abbrev('information','info',5) then call test_failed '10'
if abbrev('information','info ') then call test_failed '11'
if \abbrev('information','info',3) then call test_failed '12'
if abbrev('info','information',3) then call test_failed '13'
if abbrev('info','info',5) then call test_failed '14'
say '... ABBREV done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
