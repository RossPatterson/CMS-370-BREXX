/* ERRORTEXT */
say 'Testing ERRORTEXT ...'
fail_count=0
/* These from TRL2. */
if errortext(16) \== 'Label not found' then call test_failed '1'
if errortext(62) \== '' then call test_failed '2'
/* These from Mark Hessling. */
if errortext(10) \== 'Unexpected or unmatched END' then call test_failed '3'
if errortext(40) \== 'Incorrect call to routine' then call test_failed '4'
/* There is a 50 these days
if errortext(50) \== '' then call test_failed '5'
*/
if errortext( 1) \== '' then call test_failed '6'
say '... ERRORTEXT done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
