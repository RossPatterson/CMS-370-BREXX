/* WORDINDEX */
say 'Testing WORDINDEX ...'
fail_count=0
/* These from TRL2. */
if wordindex('Now is the time',3) \=8  then call test_failed '1'
if wordindex('Now is the time',6) \=0  then call test_failed '2'
/* These from Mark Hessling. */
if wordindex('This is certainly a test',1) \==  '1'  then call test_failed '3'
if wordindex('  This is certainly a test',1) \==  '3'  then call test_failed '4'
if wordindex('This   is certainly a test',1) \==  '1'  then call test_failed '5'
if wordindex('  This   is certainly a test',1) \==  '3'  then call test_failed '6'
if wordindex('This is certainly a test',2) \==  '6'  then call test_failed '7'
if wordindex('This   is certainly a test',2) \==  '8'  then call test_failed '8'
if wordindex('This is   certainly a test',2) \==  '6'  then call test_failed '9'
if wordindex('This   is   certainly a test',2) \==  '8'  then call test_failed '10'
if wordindex('This is certainly a test',5) \==  '21'   then call test_failed '11'
if wordindex('This is certainly a   test',5) \==  '23'  then call test_failed '12'
if wordindex('This is certainly a test  ',5) \==  '21'  then call test_failed '13'
if wordindex('This is certainly a test  ',6) \==  '0'   then call test_failed '14'
if wordindex('This is certainly a test',6) \==  '0'     then call test_failed '15'
if wordindex('This is certainly a test',7) \==  '0'     then call test_failed '16'
if wordindex('This is certainly a test  ',7) \==  '0'    then call test_failed '17'
say '... WORDINDEX done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
