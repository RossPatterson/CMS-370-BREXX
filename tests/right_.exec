/* RIGHT */
say 'Testing RIGHT ...'
fail_count=0
/* These from TRL2. */
if right('abc  d',8) \== '  abc  d'        then call test_failed '1'
if right('abc def',5) \== 'c def'          then call test_failed '2'
if right('12',5,'0') \== '00012'           then call test_failed '3'
/* These from Mark Hessling. */
if right('',4) \==            '    '                    then call test_failed '4'
if right('foobar',0) \==      ''                        then call test_failed '5'
if right('foobar',3) \==      'bar'                     then call test_failed '6'
if right('foobar',6) \==      'foobar'                  then call test_failed '7'
if right('foobar',8) \==      '  foobar'                then call test_failed '8'
if right('foobar',8,'*') \==  '**foobar'                then call test_failed '9'
if right('foobar',4,'*') \==  'obar'                    then call test_failed '10'
say '... RIGHT done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
