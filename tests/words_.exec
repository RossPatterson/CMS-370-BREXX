/* WORDS */
say 'Testing WORDS ...'
fail_count=0
/* These from TRL2. */
if words('Now is the time') \= 4 then call test_failed '1'
if words(' ') \= 0 then call test_failed '2'
/* These from Mark Hessling. */
if words('This is certainly a test') \== 5 then call test_failed '3'
if words(' This is certainly a test') \== 5 then call test_failed '4'
if words('This is certainly a test') \== 5 then call test_failed '5'
if words('This is certainly a test ') \== 5 then call test_failed '6'
if words(' hepp ') \== 1 then call test_failed '7'
if words(' hepp hepp ') \== 2 then call test_failed '8'
if words('') \== 0 then call test_failed '9'
if words(' ') \== 0 then call test_failed '10'
say '... WORDS done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
