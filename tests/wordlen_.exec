/* WORDLENGTH */
say 'Testing WORDLENGTH ...'
fail_count=0
/* These from TRL2. */
if wordlength('Now is the time',2) \=2 then call test_failed '1'
if wordlength('Now comes the time',2) \=5 then call test_failed '2'
if wordlength('Now is the time',6) \=0 then call test_failed '3'
/* These from Mark Hessling. */
if wordlength('This is certainly a test',1) \== '4' then call test_failed '4'
if wordlength('This is certainly a test',2) \== '2' then call test_failed '5'
if wordlength('This is certainly a test',5) \== '4' then call test_failed '6'
if wordlength('This is certainly a test ',5) \== '4' then call test_failed '7'
if wordlength('This is certainly a test',6) \== '0' then call test_failed '8'
if wordlength('',1) \== '0' then call test_failed '9'
if wordlength('',10) \== '0' then call test_failed '10'
say '... WORDLENGTH done'
exit fail_count
test_failed:
say 'failed in test' arg(1)
fail_count=fail_count+1
return
